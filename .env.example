# Local development defaults. The easiest way to fill this in is the guided
# setup: run `pnpm setup` — it copies this file to `.env`, generates all
# secrets, and explains every value in plain language. Manual route: copy to
# `.env` yourself and replace all production secrets before deploying.
# Reference for every variable: docs/ENVIRONMENT_VARIABLES.md
# (hosted at https://qqueue.app/docs/environment-variables)
NODE_ENV=development
API_PORT=4000

# Production domain used by Caddy in docker-compose.prod.yml.
# Point an A record for this domain at the VPS before starting production.
DOMAIN=mail.example.com

# Local development uses localhost. Production compose uses the private
# Docker network service name `postgres`; do not publish Postgres publicly.
POSTGRES_USER=qqueue
POSTGRES_PASSWORD=change-me
POSTGRES_DB=qqueue
DATABASE_URL=postgresql://qqueue:qqueue@localhost:5432/qqueue

# Optional production overrides for external services. Leave blank to use the
# bundled private Docker Compose Postgres and Redis services.
PROD_DATABASE_URL=
PROD_REDIS_HOST=
PROD_REDIS_PORT=

# Local development uses localhost. Production compose should use `redis`.
REDIS_HOST=localhost
REDIS_PORT=6379
# Only needed for hosted Redis (e.g. Upstash): its password and TLS switch.
# Leave blank/false for the bundled container.
REDIS_PASSWORD=
REDIS_TLS=false

# Generate production secrets with:
# openssl rand -hex 32
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
ENCRYPTION_KEY=change-me-32-byte-key
# Key rotation: instead of ENCRYPTION_KEY, set a comma-separated keyring —
# first key encrypts, every key decrypts. Rotate by prepending a new key,
# running `pnpm rotate-secrets`, then dropping the old key.
# ENCRYPTION_KEYS=new-key,old-key

# Public base URL where open/click tracking links resolve. Dev uses the API
# directly; production should be https://<DOMAIN> (e.g. https://mail.example.com).
APP_URL=http://localhost:4000

# Public base URL of the web dashboard. Used to build user-facing links such as
# password reset links (e.g. https://qqueue.app/reset-password?token=...).
# Dev uses the local Vite server; production should be your dashboard domain.
PUBLIC_APP_URL=http://localhost:5173

# HMAC secret for signing email open/click tracking tokens (openssl rand -hex 32).
TRACKING_SECRET=change-me
# Inbound ESP bounce/complaint webhook (POST /api/v1/webhooks/email-events).
# Disabled by default — QQueue detects bounces on its own (SMTP rejections and
# DSN parsing in inbox sync). Only enable if you relay through an ESP that
# posts normalized events to this endpoint, and set a shared secret with it.
# INBOUND_ESP_WEBHOOK_ENABLED=true
WEBHOOK_SECRET=

# How many reverse-proxy hops sit in front of the API (Express "trust proxy").
# The bundled Caddy deployment is 1 (the default). Set 0 if the API is exposed
# directly; raise it if another proxy (nginx, a CDN) fronts Caddy. Rate limits
# key on the wrong IP when this is wrong.
# TRUST_PROXY=1

# Echo the raw password-reset token in the API response, for local development
# without a working SMTP connection. Never enable this on a real instance.
# DEV_ECHO_RESET_TOKEN=true

# Mailcow provisioning (optional). With both set, owners/admins can create
# team mailboxes from the dashboard's Mailboxes page: QQueue creates the
# mailbox, holds an app password for sending, and connects the inbox for
# bounce tracking. The API key comes from Mailcow's Admin -> API (read/write).
# MAILCOW_API_URL=https://mail.example.com
# MAILCOW_API_KEY=
# Where provisioned mailboxes speak SMTP/IMAP. Defaults to the MAILCOW_API_URL
# hostname on ports 465 (SMTP) and 993 (IMAP), both implicit TLS.
# MAILCOW_MAIL_HOST=
# MAILCOW_SMTP_PORT=465
# MAILCOW_IMAP_PORT=993

# Object storage (S3-compatible) for email attachments. Local development uses
# the bundled MinIO container (docker-compose.yml) via localhost:9100.
# Production compose ignores this local S3_ENDPOINT and defaults to the private
# in-stack MinIO service. To use external production object storage, add
# PROD_S3_ENDPOINT to `.env` and point it at your S3-compatible endpoint.
# For MinIO/most self-hosted S3, keep S3_FORCE_PATH_STYLE=true. For AWS S3, set
# PROD_S3_ENDPOINT to an empty value and set S3_FORCE_PATH_STYLE=false.
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=qqueue-attachments
S3_ACCESS_KEY_ID=qqueue
S3_SECRET_ACCESS_KEY=qqueue-secret
S3_FORCE_PATH_STYLE=true
# Production MinIO root password (used by the bundled minio service).
MINIO_ROOT_PASSWORD=qqueue-secret
# Per-attachment size ceiling in bytes (default 10 MB).
ATTACHMENT_MAX_BYTES=10485760
# Auto-suppression defaults (used when an org has no SuppressionPolicy row).
# A soft (transient) bounce only suppresses once this many occur within the
# window; hard bounces and complaints always suppress immediately. The API and
# worker must agree on these values.
SOFT_BOUNCE_THRESHOLD=3
SOFT_BOUNCE_WINDOW_DAYS=30
# Default per-recipient-domain send cap (messages/minute) used when an org has no
# DomainThrottle row for the domain or a default. The API and worker must agree.
DEFAULT_DOMAIN_MAX_PER_MINUTE=60
# Worker polling cadence for active inbox accounts.
INBOX_SYNC_INTERVAL_SECONDS=120
# First sync imports only the latest N messages; later syncs use the stored UID.
INBOX_SYNC_MAX_MESSAGES=50

# --- Push notifications (Web Push / VAPID) ----------------------------------
# `pnpm setup` generates this pair for you. Both blank = notifications are off:
# the dashboard hides the "turn on alerts" control instead of asking for a
# permission it could never act on. The API and worker must use the SAME pair —
# the API hands the public key to browsers, the worker signs with the private
# one. Changing them invalidates every device that has already subscribed, so
# treat them like the other secrets and back them up with your .env.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address a push service can reach you on if deliveries misbehave
# (RFC 8292). Must be a mailto: or https: URL.
VAPID_SUBJECT=mailto:admin@example.com

# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
