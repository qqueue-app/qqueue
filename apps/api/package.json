{
  "name": "@qqueue/api",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "prisma": {
    "schema": "prisma/schema"
  },
  "scripts": {
    "rotate-secrets": "tsx scripts/rotate-secrets.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "node --env-file=../../.env ./node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node --env-file=../../.env ./node_modules/prisma/build/index.js migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@qqueue/crypto": "workspace:*",
    "@qqueue/email-engine": "workspace:*",
    "@qqueue/shared": "workspace:*",
    "@qqueue/storage": "workspace:*",
    "bullmq": "^5.34.5",
    "cors": "^2.8.5",
    "cron-parser": "^5.5.0",
    "csv-parse": "^7.0.0",
    "csv-stringify": "^6.8.0",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "imapflow": "^1.4.1",
    "ioredis": "^5.10.1",
    "multer": "^2.0.1",
    "pino": "^10.3.1",
    "web-push": "^3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/web-push": "^3",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
